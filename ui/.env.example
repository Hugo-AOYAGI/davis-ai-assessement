# Agent server the chat connects to (`uv run langgraph dev` serves on :2024), and the agent id.
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=agent
# Optional auth scheme header sent with every request.
NEXT_PUBLIC_AUTH_SCHEME=

# Deployed setup: the browser calls this site's /api proxy, which forwards to the server.
# NEXT_PUBLIC_API_URL="https://my-website.com/api"
# AGENT_SERVER_URL="https://my-agent-server.example.com"
# AGENT_SERVER_API_KEY="..."
